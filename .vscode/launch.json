{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Client (Debug)",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:VINTAGE_STORY}/Vintagestory.exe",
            "preLaunchTask": "build",
            "args": [
                "--tracelog",
                "--addModPath",
                "${workspaceFolder}/TradeRoutesDeluxe/bin/Debug/Mods",
                "--addOrigin",
                "${workspaceFolder}/TradeRoutesDeluxe/assets"
            ],
            "cwd": "${env:VINTAGE_STORY}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Launch Server",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:VINTAGE_STORY}/VintagestoryServer.exe",
            "preLaunchTask": "build",
            "args": [
                "--tracelog",
                "--addModPath",
                "${workspaceFolder}/TradeRoutesDeluxe/bin/Debug/Mods",
                "--addOrigin",
                "${workspaceFolder}/TradeRoutesDeluxe/assets"
            ],
            "cwd": "${env:VINTAGE_STORY}",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
